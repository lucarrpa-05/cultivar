{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cultivar.app/schema/card.schema.json",
  "title": "Cultivar card (parsed)",
  "description": "A card after parsing the Markdown file: front matter fields plus derived title/body/rigor/recall.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "topic", "format", "difficulty", "language", "weight", "angles", "tags", "sources", "dates", "author", "title", "body", "layer"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$", "maxLength": 120 },
    "topic": { "$ref": "#/definitions/topicId" },
    "topics": { "type": "array", "items": { "$ref": "#/definitions/topicId" }, "maxItems": 4, "uniqueItems": true },
    "format": { "enum": ["idea", "series", "fact", "quote", "story", "news", "callback", "challenge", "recall"] },
    "layer": { "enum": ["intuition", "both", "rigor"] },
    "intuitionCard": { "$ref": "#/definitions/cardId" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "language": { "enum": ["en", "es"] },
    "weight": { "enum": ["light", "medium", "heavy"] },
    "angles": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["paradox", "history", "feud", "mistake", "connection", "tool", "open-problem", "weird", "beautiful", "practical", "human", "numbers", "origin", "prediction"] }
    },
    "tags": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" } },
    "prerequisites": { "type": "array", "items": { "$ref": "#/definitions/topicId" }, "maxItems": 8, "uniqueItems": true },
    "hook": { "type": "string", "maxLength": 140 },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "index", "total", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "index": { "type": "integer", "minimum": 1, "maximum": 12 },
        "total": { "type": "integer", "minimum": 2, "maximum": 12 },
        "title": { "type": "string", "maxLength": 60 }
      }
    },
    "callback": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/definitions/topicId" }, "to": { "$ref": "#/definitions/topicId" } }
    },
    "related": { "type": "array", "items": { "$ref": "#/definitions/cardId" }, "maxItems": 8, "uniqueItems": true },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url", "type"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "url": { "type": "string", "pattern": "^https://" },
          "author": { "type": "string", "maxLength": 120 },
          "year": { "type": "integer", "minimum": -700, "maximum": 2100 },
          "type": { "enum": ["paper", "book", "wiki", "article", "video", "dataset", "primary", "blog", "encyclopedia"] }
        }
      }
    },
    "dates": {
      "type": "object", "additionalProperties": false, "required": ["written"],
      "properties": {
        "written": { "$ref": "#/definitions/date" },
        "event": { "$ref": "#/definitions/date" },
        "expires": { "$ref": "#/definitions/date" }
      }
    },
    "evergreen": { "type": "boolean" },
    "diagram": {
      "type": "object", "additionalProperties": false, "required": ["file", "caption", "alt"],
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z0-9/_-]+\\.svg$" },
        "caption": { "type": "string", "maxLength": 200 },
        "alt": { "type": "string", "maxLength": 200 },
        "svg": { "type": "string" }
      }
    },
    "rigor": { "enum": ["none"] },
    "rigorNote": { "type": "string", "maxLength": 200 },
    "author": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "reviewed": {
      "type": "object", "additionalProperties": false, "required": ["by", "at", "verdict"],
      "properties": {
        "by": { "type": "string" },
        "at": { "$ref": "#/definitions/date" },
        "verdict": { "enum": ["approved"] },
        "notes": { "type": "string", "maxLength": 500 }
      }
    },
    "answersQuestion": { "type": "string", "pattern": "^q-[a-z0-9-]+$" },
    "context": { "type": "string", "pattern": "^context:[a-z0-9:-]+$" },

    "title": { "type": "string", "minLength": 8, "maxLength": 80 },
    "body": { "type": "string", "minLength": 80 },
    "rigorBody": { "type": ["string", "null"] },
    "recall": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "question"],
      "properties": {
        "type": { "enum": ["mcq", "reveal"] },
        "question": { "type": "string", "minLength": 8, "maxLength": 300 },
        "answer": { "type": "string", "maxLength": 600 },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["text", "correct", "why"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 200 },
              "correct": { "type": "boolean" },
              "why": { "type": "string", "minLength": 3, "maxLength": 300 }
            }
          }
        }
      }
    },
    "words": {
      "type": "object", "additionalProperties": false,
      "properties": { "body": { "type": "integer" }, "rigor": { "type": "integer" } }
    },
    "file": { "type": "string" }
  },
  "definitions": {
    "topicId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){0,2}$" },
    "cardId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "allOf": [
    { "if": { "properties": { "format": { "const": "series" } } }, "then": { "required": ["series"] } },
    { "if": { "properties": { "format": { "const": "callback" } } }, "then": { "required": ["callback"] } },
    { "if": { "properties": { "layer": { "const": "rigor" } } }, "then": { "required": ["intuitionCard"] } },
    { "if": { "properties": { "format": { "const": "news" } } }, "then": { "properties": { "dates": { "required": ["written", "event", "expires"] } } } },
    { "if": { "required": ["rigor"], "properties": { "rigor": { "const": "none" } } }, "then": { "required": ["rigorNote"] } }
  ]
}
